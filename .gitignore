# ============================================================
#  一、白名单模式（核心）
#  先忽略一切，再放行需要提交的内容
# ============================================================
*

# ------------------------------------------------------------
#  放行需要提交的文件夹（框选部分）
#  注意：必须成对写  !目录/  和  !目录/**  才能放行目录内所有内容
# ------------------------------------------------------------
# !project/
# !project/**  # 注释掉，不再放行project，实现整个project全部忽略
!xiaohashu2/
!xiaohashu2/**
!xiaohashu-vue3/
!xiaohashu-vue3/**

# XXL-JOB：保留 Maven 模块源码、资源和构建配置
!/xxl-job-3.4.0/
!/xxl-job-3.4.0/**

# 插件：只保留启动脚本、配置、SQL 和许可证；运行依赖从对应版本发行包恢复
!/plugins/
!/plugins/canal/
!/plugins/canal/canal.deployer-1.1.8/
!/plugins/canal/canal.deployer-1.1.8/bin/
!/plugins/canal/canal.deployer-1.1.8/bin/**
!/plugins/canal/canal.deployer-1.1.8/conf/
!/plugins/canal/canal.deployer-1.1.8/conf/**
!/plugins/logstash-7.17.29/
!/plugins/logstash-7.17.29/bin/
!/plugins/logstash-7.17.29/bin/logstash
!/plugins/logstash-7.17.29/bin/logstash.bat
!/plugins/logstash-7.17.29/bin/logstash.lib.sh
!/plugins/logstash-7.17.29/bin/setup.bat
!/plugins/logstash-7.17.29/bin/logstash-plugin
!/plugins/logstash-7.17.29/bin/logstash-plugin.bat
!/plugins/logstash-7.17.29/bin/logstash-keystore
!/plugins/logstash-7.17.29/bin/logstash-keystore.bat
!/plugins/logstash-7.17.29/config/
!/plugins/logstash-7.17.29/config/**
!/plugins/logstash-7.17.29/LICENSE.txt
!/plugins/logstash-7.17.29/NOTICE.TXT

# Nginx：保留运行程序、配置、静态页面和随附许可证
!/nginx-1.18.0/
!/nginx-1.18.0/nginx.exe
!/nginx-1.18.0/conf/
!/nginx-1.18.0/conf/**
!/nginx-1.18.0/html/
!/nginx-1.18.0/html/50x.html
!/nginx-1.18.0/html/hmdp/
!/nginx-1.18.0/html/hmdp/**
!/nginx-1.18.0/docs/
!/nginx-1.18.0/docs/*LICENSE
!/nginx-1.18.0/docs/*.LICENCE

# ------------------------------------------------------------
#  放行需要提交的单个文件
# ------------------------------------------------------------
!.gitignore
!AI助手融合实施方案-v1.1.md

# ============================================================
#  二、例外：在已放行的目录中，再排除掉不应提交的内容
#  （白名单模式下，这些"反向排除"仍然有效）
# ============================================================

# --- Java / Maven 编译产物 ---
**/target/
!**/target/.gitkeep
**/.flattened-pom.xml
dependency-reduced-pom.xml

# --- 前端依赖 / 打包产物 ---
**/node_modules/
**/dist/
**/dist-ssr/
**/coverage/
**/*.tsbuildinfo
.vite/

# --- 日志 ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- 敏感配置文件 ---
.env
.env.local
.env.*.local

# 所有 yml / yaml 配置文件全部忽略
**/*.yml
**/*.yaml

# --- 敏感非 yml 配置文件 ---
**/generatorConfig.xml
**/leaf.properties
**/mcp-servers-config.json
**/DruidTests.java

# --- IDE / 编辑器缓存 ---
.idea/
.vscode/
*.iml
*.iws
*.ipr

.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# --- 操作系统临时文件 ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- AI 助手项目 - 本地运行时生成的文件 ---
**/chunk/
**/uploads/
**/upload/

# --- 文档构建产物 ---
*.pdf

# --- AI / E2E 测试运行时缓存 ---
.codex-e2e/
.codex/
*.codex-e2e
.playwright/
.puppeteer/
edge-cdp/
**/test-results/
**/playwright-report/
**/.cache/

# --- XXL-JOB 非运行内容（doc/db 建表 SQL 在下方单独放行）---
/xxl-job-3.4.0/.github/
/xxl-job-3.4.0/docker/
/xxl-job-3.4.0/doc/*

# 管理端本地数据库凭证，按部署环境自行补充
/xxl-job-3.4.0/xxl-job-admin/src/main/resources/application.properties

# --- 插件本地状态、备份、可下载的 JDBC 驱动和凭证配置 ---
/plugins/**/*.pid
/plugins/**/nohup.out
/plugins/**/*.bak*
/plugins/canal/**/conf/**/meta.dat*
/plugins/canal/**/conf/**/*.mv.db
/plugins/canal/**/conf/**/*.trace.db
/plugins/canal/**/conf/canal_local.properties
/plugins/canal/**/conf/*/instance.properties
/plugins/logstash-7.17.29/config/**/*.jar
/plugins/logstash-7.17.29/config/**/last_run_time
/plugins/logstash-7.17.29/config/**/logstash_jdbc_last_run
/plugins/logstash-7.17.29/config/**/logstash.keystore
/plugins/logstash-7.17.29/config/mysql/**/jdbc.conf

# --- Nginx 静态目录中的 Git 元数据和运行时上传图片 ---
/.git-backups/
/nginx-1.18.0/**/.git/
/nginx-1.18.0/html/hmdp/imgs/blogs/*

# ============================================================
#  三、明确要保留但可能被上面二次排除的文件（可选）
# ============================================================
!.gitkeep

# XXL-JOB 初始化 SQL 与管理页面必需的 AdminLTE 静态资源
!/xxl-job-3.4.0/doc/db/
!/xxl-job-3.4.0/doc/db/**
!/xxl-job-3.4.0/xxl-job-admin/src/main/resources/static/adminlte/dist/
!/xxl-job-3.4.0/xxl-job-admin/src/main/resources/static/adminlte/dist/**

